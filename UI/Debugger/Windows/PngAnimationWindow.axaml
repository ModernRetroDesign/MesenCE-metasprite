<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:Mesen.Debugger.ViewModels" xmlns:u="using:Mesen.Debugger.Utilities"
 x:Class="Mesen.Debugger.Windows.PngAnimationWindow" x:DataType="vm:PngAnimationViewModel"
 Title="{Binding Title}" Width="780" Height="690" MinWidth="560" MinHeight="480">
 <DockPanel Margin="12">
  <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0 8 0 0">
   <TextBlock Text="{Binding MemoryInfo}" TextWrapping="Wrap" />
   <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
   <StackPanel Orientation="Horizontal" Spacing="8">
    <Button Name="animationSave" Content="Save and apply" Click="Save" /><Button Content="Cancel" Click="Cancel" />
   </StackPanel>
  </StackPanel>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
   <StackPanel Spacing="8">
    <CheckBox Content="Enable PNG animation" IsChecked="{Binding Enabled}" />
    <TextBlock Text="Durations use emulated frames. Pause freezes playback; turbo follows emulation speed. Without restart, play-once starts with the game." TextWrapping="Wrap" />
    <CheckBox Name="animationRestart" Content="Restart when conditions activate / this artwork is selected" IsChecked="{Binding RestartOnActivation}" />
    <TextBlock Text="Restart uses RAM conditions and alternate selection, shared by all matching copies of this group. Without conditions, it starts when the pack is applied. Moving offscreen does not restart it. Save states restore timing with the same pack. Older states or changed packs start a fresh activation." TextWrapping="Wrap" />
    <TextBlock Text="{Binding ScaleInfo}" TextWrapping="Wrap" />
    <ComboBox SelectedIndex="{Binding PlaybackMode}" HorizontalAlignment="Stretch">
     <ComboBoxItem Content="Loop" /><ComboBoxItem Content="Ping-pong" /><ComboBoxItem Content="Play once (hold last frame)" />
    </ComboBox>
    <WrapPanel>
     <Button Content="+" Width="32" Click="Add" ToolTip.Tip="Add a PNG frame; files outside the pack are copied into its folder." />
     <Button Content="−" Width="32" Click="Remove" IsEnabled="{Binding HasFrame}" />
     <Button Name="animationPrevious" Content="Previous" Click="Previous" IsEnabled="{Binding HasFrame}" /><Button Name="animationNext" Content="Next" Click="Next" IsEnabled="{Binding HasFrame}" />
     <Button Content="Earlier" Click="Earlier" IsEnabled="{Binding HasFrame}" /><Button Content="Later" Click="Later" IsEnabled="{Binding HasFrame}" />
    </WrapPanel>
    <ComboBox ItemsSource="{Binding Frames}" SelectedItem="{Binding SelectedFrame}" HorizontalAlignment="Stretch">
     <ComboBox.ItemTemplate><DataTemplate x:DataType="u:MetaPngAnimationFrame"><TextBlock Text="{Binding Path}" /></DataTemplate></ComboBox.ItemTemplate>
    </ComboBox>
    <TextBlock Text="{Binding FrameInfo}" TextWrapping="Wrap" />
    <Grid ColumnDefinitions="Auto,*" IsEnabled="{Binding HasFrame}">
     <TextBlock Text="Frame duration" VerticalAlignment="Center" Margin="0 0 12 0" />
     <NumericUpDown Grid.Column="1" Value="{Binding FrameDuration}" Minimum="1" Maximum="3600000" Increment="1" />
    </Grid>
    <CheckBox Content="Override this frame's origin" IsChecked="{Binding OverrideOrigin}" IsEnabled="{Binding HasFrame}" />
    <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding OverrideOrigin}">
     <TextBlock Text="X" VerticalAlignment="Center" /><NumericUpDown Value="{Binding FrameOriginX}" Minimum="-4096" Maximum="4096" Width="130" />
     <TextBlock Text="Y" VerticalAlignment="Center" /><NumericUpDown Value="{Binding FrameOriginY}" Minimum="-4096" Maximum="4096" Width="130" />
    </StackPanel>
    <TextBlock Text="Click the PNG preview to set this frame's origin." TextWrapping="Wrap" />
    <Border Background="#404040" MinHeight="180" Padding="4">
     <ScrollViewer MaxHeight="300" HorizontalScrollBarVisibility="Auto">
      <Canvas Width="{Binding PreviewWidth}" Height="{Binding PreviewHeight}" Background="Transparent" PointerPressed="Origin">
       <Image Source="{Binding Preview}" Width="{Binding PreviewWidth}" Height="{Binding PreviewHeight}" />
       <Border Background="Red" Width="1" Height="{Binding PreviewHeight}" Canvas.Left="{Binding PreviewOriginX}" IsHitTestVisible="False" />
       <Border Background="Red" Height="1" Width="{Binding PreviewWidth}" Canvas.Top="{Binding PreviewOriginY}" IsHitTestVisible="False" />
      </Canvas>
     </ScrollViewer>
    </Border>
    <StackPanel Orientation="Horizontal" Spacing="8">
     <Button Name="animationPlay" Content="Play / restart preview" Click="Play" IsEnabled="{Binding HasFrame}" /><Button Name="animationStop" Content="Stop preview" Click="Stop" />
    </StackPanel>
    <TextBlock Text="Preview: 60 frames/s. Removing a frame or cancelling keeps imported PNG files in the pack folder." TextWrapping="Wrap" />
   </StackPanel>
  </ScrollViewer>
 </DockPanel>
</Window>
