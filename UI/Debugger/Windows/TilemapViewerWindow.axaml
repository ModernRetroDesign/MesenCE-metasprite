<Window
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:m="clr-namespace:Mesen"
	xmlns:vm="using:Mesen.ViewModels"
	xmlns:sys="using:System"
	xmlns:v="using:Mesen.Views"
	xmlns:c="using:Mesen.Controls"
	xmlns:i="using:Mesen.Interop"
	xmlns:l="using:Mesen.Localization"
	xmlns:dvm="using:Mesen.Debugger.ViewModels"
	xmlns:dc="using:Mesen.Debugger.Controls"
	xmlns:dv="using:Mesen.Debugger.Views"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="600"
	x:Class="Mesen.Debugger.Windows.TilemapViewerWindow"
	x:DataType="dvm:TilemapViewerViewModel"
	Width="600" Height="600"
	Title="{l:Translate wndTitle}"
	Icon="/Assets/VideoOptions.png"
>
	<Design.DataContext>
		<dvm:TilemapViewerViewModel />
	</Design.DataContext>

	<DockPanel>
		<Panel DockPanel.Dock="Top">
			<c:MesenMenu DockPanel.Dock="Top" Name="ActionMenu">
				<MenuItem Header="{l:Translate mnuFile}" ItemsSource="{Binding FileMenuActions}" />
				<MenuItem Header="{l:Translate mnuView}" ItemsSource="{Binding ViewMenuActions}" />
			</c:MesenMenu>
			<c:IconButton
				HorizontalAlignment="Right"
				DockPanel.Dock="Right"
				ToolTip.Tip="{l:Translate btnToggleSettings}"
				Click="OnSettingsClick"
				Icon="Assets/Settings.png"
			/>
		</Panel>

		<dv:RefreshTimingView DataContext="{Binding RefreshTiming}" DockPanel.Dock="Bottom" />

		<ScrollViewer DockPanel.Dock="Right" MaxWidth="320" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding Config.ShowSettingsPanel}">
			<StackPanel Margin="3">
				<Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,Auto" IsVisible="{Binding IsTilemapInfoVisible}">
					<TextBlock Text="{l:Translate lblDisplayMode}" />
					<c:EnumComboBox
						SelectedItem="{Binding Config.DisplayMode}"
						AvailableValues="{Binding AvailableDisplayModes}"
						Width="100"
						Grid.Column="1"
					/>
					<TextBlock Text="{l:Translate lblBackground}" Grid.Row="1" />
					<c:EnumComboBox SelectedItem="{Binding Config.Background}" Width="100" Grid.Column="1" Grid.Row="1" />
				</Grid>
				<c:GroupBox Header="Background PNG replacements" DataContext="{Binding BackgroundEditor}" x:DataType="dvm:MetaBackgroundEditorViewModel"><StackPanel>							<TextBlock Text="Background PNG layers" FontWeight="Bold" />
							<TextBlock Text="Background layers: NES, GB/GBC, GBA, PCE, SMS, SNES and WonderSwan.&#10;Export saves the full selected tilemap with transparency to the default pack folder." TextWrapping="Wrap" />
							<Button Content="Export selected tilemap PNG" Click="OnExportMetaBackground" />
							<Button Content="Import background PNG" Click="OnImportMetaBackground" />
							<Button Content="Replace selected PNG" Click="OnReplaceMetaBackground" ToolTip.Tip="Keep the selected background's placement, scale and CPU conditions while loading new artwork." />
							<ComboBox ItemsSource="{Binding MetaBackgrounds}" SelectedItem="{Binding SelectedMetaBackground}" />
							<Button Content="Remove selected background layer" Click="OnRemoveMetaBackground" />
							<Border Background="#404040" MaxHeight="200">
								<Image Source="{Binding MetaBackgroundPreview}" Stretch="Uniform" MaxHeight="200" />
							</Border>
							<TextBlock Text="{Binding MetaBackgroundPreviewInfo}" TextWrapping="Wrap" />
							<TextBox PlaceholderText="Background name" Text="{Binding SelectedMetaBackground.Name}" />
							<TextBlock Text="Hardware layer" />
							<NumericUpDown Minimum="0" Maximum="7" Value="{Binding SelectedMetaBackground.NativeLayer}" />
							<TextBlock Text="Placement X / Y (native pixels)" />
							<StackPanel Orientation="Horizontal">
								<NumericUpDown Width="105" Minimum="-4096" Maximum="4096" Value="{Binding SelectedMetaBackground.X}" />
								<NumericUpDown Width="105" Minimum="-4096" Maximum="4096" Value="{Binding SelectedMetaBackground.Y}" />
							</StackPanel>
							<TextBlock Text="PNG scale" />
							<NumericUpDown Minimum="1" Maximum="10" Value="{Binding SelectedMetaBackground.ArtworkScale}" />
							<CheckBox Content="Follow selected scroll source" IsChecked="{Binding SelectedMetaBackground.FollowScroll}" />
							<TextBlock Text="Scroll source" />
							<ComboBox SelectedIndex="{Binding SelectedMetaBackground.ScrollSourceIndex}">
								<ComboBoxItem Content="Hardware scrolling" /><ComboBoxItem Content="CPU memory camera" />
							</ComboBox>
							<StackPanel IsVisible="{Binding SelectedMetaBackground.UseCpuCamera}" IsEnabled="{Binding SelectedMetaBackground.FollowScroll}">
								<TextBlock Text="{Binding SavedCameraInfo}" TextWrapping="Wrap" />
								<Button Content="Save camera for this game" Click="OnSaveCpuCamera" IsVisible="{Binding SelectedMetaBackground.CameraEditable}" />
								<Button Content="Link saved camera to this background" Click="OnLinkCpuCamera" IsEnabled="{Binding HasSavedCamera}" IsVisible="{Binding SelectedMetaBackground.CameraEditable}" />
								<Button Content="Unlink camera (keep settings)" Click="OnUnlinkCpuCamera" IsVisible="{Binding SelectedMetaBackground.UseSavedCamera}" />
								<StackPanel IsVisible="{Binding SelectedMetaBackground.CameraEditable}">
								<TextBlock Text="X camera format" />
								<ComboBox SelectedIndex="{Binding SelectedMetaBackground.CameraX.Format}">
									<ComboBoxItem Content="Fixed" /><ComboBoxItem Content="8-bit unsigned" /><ComboBoxItem Content="16-bit, low byte first" /><ComboBoxItem Content="16-bit, high byte first" /><ComboBoxItem Content="Pixel offset + page" />
								</ComboBox>
								<TextBlock Text="X start / pixel offset address (hex)" TextWrapping="Wrap" />
								<TextBox Text="{Binding SelectedMetaBackground.CameraX.AddressHex}" />
								<StackPanel IsVisible="{Binding SelectedMetaBackground.CameraX.IsPaged}">
									<TextBlock Text="X page address (hex)" /><TextBox Text="{Binding SelectedMetaBackground.CameraX.PageAddressHex}" />
									<CheckBox Content="Signed page (FF = −1)" IsChecked="{Binding SelectedMetaBackground.CameraX.SignedPage}" />
									<TextBlock Text="X page size (pixels)" /><NumericUpDown Minimum="1" Maximum="65536" Value="{Binding SelectedMetaBackground.CameraX.PageSize}" />
								</StackPanel>
								<TextBlock Text="Y camera format" />
								<ComboBox SelectedIndex="{Binding SelectedMetaBackground.CameraY.Format}">
									<ComboBoxItem Content="Fixed" /><ComboBoxItem Content="8-bit unsigned" /><ComboBoxItem Content="16-bit, low byte first" /><ComboBoxItem Content="16-bit, high byte first" /><ComboBoxItem Content="Pixel offset + page" />
								</ComboBox>
								<TextBlock Text="Y start / pixel offset address (hex)" TextWrapping="Wrap" />
								<TextBox Text="{Binding SelectedMetaBackground.CameraY.AddressHex}" />
								<StackPanel IsVisible="{Binding SelectedMetaBackground.CameraY.IsPaged}">
									<TextBlock Text="Y page address (hex)" /><TextBox Text="{Binding SelectedMetaBackground.CameraY.PageAddressHex}" />
									<CheckBox Content="Signed page (FF = −1)" IsChecked="{Binding SelectedMetaBackground.CameraY.SignedPage}" />
									<TextBlock Text="Y page size (pixels)" /><NumericUpDown Minimum="1" Maximum="65536" Value="{Binding SelectedMetaBackground.CameraY.PageSize}" />
								</StackPanel>
								</StackPanel>
								<TextBlock Text="{Binding CameraReadout}" TextWrapping="Wrap" />
							</StackPanel>
							<TextBlock Text="Scroll speed X / Y&#10;1 = native, 0 = fixed, negative = reverse" TextWrapping="Wrap" />
							<StackPanel Orientation="Horizontal" IsEnabled="{Binding SelectedMetaBackground.FollowScroll}">
								<NumericUpDown Width="105" Minimum="-16" Maximum="16" Increment="0.1" FormatString="0.###" Value="{Binding SelectedMetaBackground.ScrollSpeedX}" />
								<NumericUpDown Width="105" Minimum="-16" Maximum="16" Increment="0.1" FormatString="0.###" Value="{Binding SelectedMetaBackground.ScrollSpeedY}" />
							</StackPanel>
							<CheckBox Content="Wrap horizontally" IsChecked="{Binding SelectedMetaBackground.WrapX}" />
							<StackPanel IsVisible="{Binding IsNes}">
								<CheckBox Content="Ignore raster scroll changes (NES)" IsChecked="{Binding SelectedMetaBackground.IgnoreRasterScroll}" IsEnabled="{Binding SelectedMetaBackground.UseHardwareScroll}" />
								<TextBlock Text="Reference scanline below the HUD (0–239)" TextWrapping="Wrap" />
								<NumericUpDown Minimum="0" Maximum="239" Value="{Binding SelectedMetaBackground.ScrollReferenceScanline}" IsEnabled="{Binding SelectedMetaBackground.IgnoreRasterScroll}" />
							</StackPanel>
							<CheckBox Content="Wrap vertically" IsChecked="{Binding SelectedMetaBackground.WrapY}" />
							<CheckBox Content="Enable background in gameplay" IsChecked="{Binding SelectedMetaBackground.Enabled}" />
							<CheckBox Content="Hide original layer while active" IsChecked="{Binding SelectedMetaBackground.HideOriginalLayer}" />
							<TextBlock Text="CPU memory conditions&#10;Hex values; all conditions must match" TextWrapping="Wrap" />
							<TextBox Text="{Binding MemoryConditionsText}" AcceptsReturn="True" MinHeight="70" TextWrapping="Wrap" PlaceholderText="C000 == 01 / FF" />
							<TextBlock Text="One ADDRESS OP VALUE / MASK per line.&#10;Operators: ==, !=, &gt;, &lt;, &gt;=, &lt;=.&#10;Mask defaults to FF and applies to both values before unsigned comparison.&#10;Gameplay replacement requires at least one condition. All conditions must match." TextWrapping="Wrap" />
							<Button Content="Save and apply background edits" Click="OnSaveMetaBackgrounds" />
							<Button Content="Reload saved backgrounds" Click="OnReloadMetaBackgrounds" ToolTip.Tip="Reload layers from disk, discarding unsaved background edits." />
<TextBlock Text="{Binding MetaStatus}" TextWrapping="Wrap" /></StackPanel></c:GroupBox>
				<CheckBox Content="{l:Translate chkShowGrid}" IsChecked="{Binding Config.ShowGrid}" />
				<CheckBox Content="{l:Translate chkNesShowAttributeGrid}" IsChecked="{Binding Config.NesShowAttributeGrid}" IsVisible="{Binding IsNes}" />
				<CheckBox Content="{l:Translate chkNesShowAttributeByteGrid}" IsChecked="{Binding Config.NesShowAttributeByteGrid}" IsVisible="{Binding IsNes}" />
				<CheckBox Content="{l:Translate chkNesShowTilemapGrid}" IsChecked="{Binding Config.NesShowTilemapGrid}" IsVisible="{Binding IsNes}" />
				<CheckBox Content="{l:Translate chkShowScrollOverlay}" IsChecked="{Binding Config.ShowScrollOverlay}" />

				<c:GroupBox Header="{l:Translate lblHighlightOptions}" Margin="0" IsVisible="{Binding IsNes}">
					<Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
						<TextBlock Text="{l:Translate lblTileHighlightMode}" />
						<c:EnumComboBox Grid.Column="1" SelectedItem="{Binding Config.TileHighlightMode}" />
						<TextBlock Grid.Row="1" Text="{l:Translate lblAttributeHighlightMode}" />
						<c:EnumComboBox Grid.Row="1" Grid.Column="1" SelectedItem="{Binding Config.AttributeHighlightMode}" />
					</Grid>
				</c:GroupBox>

				<c:GroupBox Header="{l:Translate lblTilemap}" Margin="0 5 0 0" IsVisible="{Binding IsTilemapInfoVisible}">
					<ContentControl Content="{Binding TilemapInfoPanel}" />
				</c:GroupBox>
				
				<c:GroupBox
					Header="{l:Translate lblSelectedTile}"
					IsVisible="{Binding PreviewPanel, Converter={x:Static ObjectConverters.IsNotNull}}"
				>
					<ContentControl Content="{Binding PreviewPanel}" />
				</c:GroupBox>
			</StackPanel>
		</ScrollViewer>

		<TabControl
			ItemsSource="{Binding Tabs}"
			SelectedItem="{Binding SelectedTab}"
			IsVisible="{Binding ShowTabs}"
			Padding="1"
			DockPanel.Dock="Top"
		>
			<TabControl.Styles>
				<Style Selector="TabItem">
					<Setter Property="IsEnabled" Value="{Binding Enabled, DataType={x:Type dvm:TilemapViewerTab}}" />
				</Style>
			</TabControl.Styles>
			<TabControl.ItemTemplate>
				<DataTemplate>
					<TextBlock Text="{Binding Title}" IsEnabled="{Binding Enabled, DataType={x:Type dvm:TilemapViewerTab}}" />
				</DataTemplate>
			</TabControl.ItemTemplate>
			<TabControl.ContentTemplate>
				<DataTemplate></DataTemplate>
			</TabControl.ContentTemplate>
		</TabControl>

		<dc:ScrollPictureViewer
			x:Name="picViewer"
			Source="{Binding ViewerBitmap}"
			Zoom="{Binding Config.ImageScale}"
			ShowGrid="{Binding Config.ShowGrid}"
			SelectionRect="{Binding SelectionRect}"
			CustomGrids="{Binding CustomGrids}"
			OverlayRect="{Binding ScrollOverlayRect}"
			GridSizeX="{Binding GridSizeX}"
			GridSizeY="{Binding GridSizeY}"
			OverlayLines="{Binding OverlayLines}"
		/>
	</DockPanel>
</Window>

