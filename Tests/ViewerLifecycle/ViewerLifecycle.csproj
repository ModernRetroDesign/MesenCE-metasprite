<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NuGetAudit>false</NuGetAudit>
    <MesenBuildConfiguration Condition="'$(MesenBuildConfiguration)'==''">Debug</MesenBuildConfiguration>
    <MesenBinaryDirectory>../../bin/win-x64/$(MesenBuildConfiguration)/</MesenBinaryDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Mesen"><HintPath>$(MesenBinaryDirectory)Mesen.dll</HintPath></Reference>
    <Reference Include="Avalonia.Base"><HintPath>$(MesenBinaryDirectory)Avalonia.Base.dll</HintPath></Reference>
    <Reference Include="Avalonia.Controls"><HintPath>$(MesenBinaryDirectory)Avalonia.Controls.dll</HintPath></Reference>
    <Reference Include="Avalonia.Markup"><HintPath>$(MesenBinaryDirectory)Avalonia.Markup.dll</HintPath></Reference>
    <Reference Include="Avalonia.Desktop"><HintPath>$(MesenBinaryDirectory)Avalonia.Desktop.dll</HintPath></Reference>
    <Reference Include="Avalonia.Skia"><HintPath>$(MesenBinaryDirectory)Avalonia.Skia.dll</HintPath></Reference>
    <Reference Include="CommunityToolkit.Mvvm"><HintPath>$(MesenBinaryDirectory)CommunityToolkit.Mvvm.dll</HintPath></Reference>
    <Content Include="$(MesenBinaryDirectory)*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
